# Use Supabase's SESSION POOLER, not the direct `db.<ref>.supabase.co` endpoint.
# The direct endpoint is IPv6-only, which works from a normal dev machine but fails with
# "Network is unreachable" from anywhere IPv4-only — Docker containers and EKS pods included.
# Copy the exact string from Supabase dashboard -> Connect -> Session pooler, then swap the
# scheme to postgresql+psycopg://. Note the username is postgres.<PROJECT_REF>, not postgres.
# Port 5432 (session mode), NOT 6543 (transaction mode): transaction mode disallows prepared
# statements, and psycopg3 prepares repeated queries automatically.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
EMBEDDING_MODEL_ID=text-embedding-3-small
# Optional — defaults to gpt-4o-mini for recommendation explanations
LLM_MODEL_ID=gpt-4o-mini
OPENAI_API_KEY=
# Optional — browser origins allowed to call the API (CORS). JSON array; defaults to the
# frontend dev server (http://localhost:3000, http://127.0.0.1:3000) if unset.
# CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
